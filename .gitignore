# ═══════════════════════════════════════════════════════════════════
#  gpic-website —— 这是个「公开」仓库，只放站点本体
#
#  仓库根只放站点本体 + 运维脚本（同步、备份），其余不推。
#  其余（工具/、社团办法通知、组织架构图、目录结构说明）全部不推。
#
#  为什么：工具/ 下是社团真实业务数据 ——
#    GPIC-CWB-001 幻电投账目核算表.xlsx
#    GPIC-SCB-001 产品计划表（长期产品）.xlsx
#    GPIC-WZB-001 仓储清单.xlsx / GPIC-WZB-002 订补货清单.xlsx
#  根目录还有四份内部办法通知与组织架构图。这些属于社团内部资料，
#  跟「官网源码」是两件事，不该进公开仓库。
#
#  改这条规则前先想清楚：公开仓库的提交历史是删不干净的。
# ═══════════════════════════════════════════════════════════════════
/*
!/.gitignore
!/.gitattributes
!/.github/
!/官网/

# 两个运维脚本放在仓库根：同步脚本做 export → build → git push，
# 备份脚本做三层快照。它们都要和 .git / .github 同层，放 官网/ 里反而别扭。
# 脚本本身不含任何业务数据，入库是为了换机器后还能照着跑。
!/同步到公网.bat
!/sync-public.mjs
!/备份.bat

# 上面 /* 已挡掉，这里再显式列一遍敏感项 —— 万一哪天 /* 被误删，
# 这几条还能兜住，同时也起「为什么不能推」的备忘作用。
/工具/
/幻想乡电力投资集团-组织架构图.jpg
/幻想乡电力投资集团寄售（暂行）办法通知.docx
/幻想乡电力投资集团画师部报酬规范（暂行）办法通知.docx
/幻想乡电力投资集团美工部报酬规范（暂行）办法通知.docx
/幻想乡电力投资集团驻场（暂行）办法通知.docx
/目录结构说明.md

# ── 凭据 / 后台：绝不上公开仓库 ──────────────────────────────────
# 根目录那份旧 admin.html（2026-09 的静态站遗留）里含 admin / 明文默认口令，
# 且登录只是前端演示级 —— 继续忽略，建议尽快删除。
官网/admin.html

# 注：官网/web/admin.html 已放行（2026-10-19）。
# 原来忽略它的两条理由现在都不成立：
#   1) 已无任何硬编码口令，登录走真实后端（PBKDF2 + auth_sessions）
#   2) 后台功能全在这一个文件里，不纳入版本库等于换台机器就丢
# 它只包含前端结构与接口调用，不含凭据；静态快照本来就不发布它
# （build-standalone.py 不复制 admin.html）。

# 建号脚本里硬编码了主催账号密码（旧明文口令）
官网/dev/create-organizer.mjs

# Qoder 站点部署描述文件（含 siteId / deploymentId / releaseId）
*.qoder.site
**/*.qoder.site

# ── 本地备份（三层快照：文件副本 + 库快照 + git bundle）─────────
# 快照里全是账目表、仓储清单、口令哈希 —— 绝不能进公开仓库。
# 但「怎么备份」这件事本身应该跟着仓库走：脚本 + 说明入库，
# 数据目录（gpic-*、db/）一律不进。
# 注意顺序：先要 !/backup/ 让 git 愿意「走进」这个目录（上面的 /* 会
# 把 backup 整个排掉，父目录被排除时，子项的白名单一律无效），
# 再用 /backup/* 把里面的东西全部关掉，最后逐个放行。
!/backup/
/backup/*
!/backup/README.md
!/backup/_tools/
/backup/_tools/*
!/backup/_tools/gpic-backup.mjs

# ── 本地工具与状态 ───────────────────────────────────────────────
.workbuddy/
**/.workbuddy/
官网/.backup-rename/
官网/functions/_qoder/
官网/.tmp-e2e/

# ── 本地备份：内容快照与图片转换前原件 ───────────────────────────
# data/.backup/                       content.json 的历史快照（17 份）
# assets/images/.backup-goods-*/      制品图转 WebP 前的 JPG 原件
官网/data/.backup/
官网/assets/images/.backup*/

# ── 自持后端：数据库与用户上传，属运行期数据，不进仓库 ────────────
# 库里有主催账号的口令哈希与会话，上传目录是用户内容
官网/server/data/
官网/web/assets/uploads/

# ── 构建产物 ─────────────────────────────────────────────────────
官网/dist/
node_modules/

# ── 系统垃圾 ─────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
~$*
*.tmp
